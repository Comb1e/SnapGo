<Window x:Class="SnapGo.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapGo Settings" Height="440" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- General -->
        <GroupBox Grid.Row="0" Header="General" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <CheckBox x:Name="ChkAutoStart" Content="Start with Windows (开机自启)"
                          Margin="0,0,0,6" />
                <CheckBox x:Name="ChkStartMinimized"
                          Content="Start minimized to system tray"
                          Margin="0,0,0,0" />
            </StackPanel>
        </GroupBox>

        <!-- Docker Mode -->
        <GroupBox Grid.Row="1" Header="Docker OCR Service" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Docker launches on first OCR request. Mode controls behavior after first start."
                           FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbAlways" Content="Stay running" Margin="0,0,12,0"
                                 GroupName="DockerMode" />
                    <RadioButton x:Name="RbOnDemand" Content="On demand" Margin="0,0,12,0"
                                 GroupName="DockerMode" />
                    <RadioButton x:Name="RbSmart" Content="Smart (auto-stop)" Margin="0,0,0,0"
                                 GroupName="DockerMode" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Idle timeout (min):" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="TxtIdleTimeout" Width="50" Text="30" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Hotkey -->
        <GroupBox Grid.Row="2" Header="Shortcut" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Screenshot hotkey:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="TxtHotkey" Width="180" Text="Control+Shift+S" IsReadOnly="True" />
            </StackPanel>
        </GroupBox>

        <!-- Save Path -->
        <GroupBox Grid.Row="3" Header="Storage" Padding="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Default save path:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="TxtSavePath" Width="250" />
                <Button Content="..." Width="28" Height="24" Margin="4,0,0,0"
                        Click="BrowseSavePath_Click" />
            </StackPanel>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Save" Width="70" Height="28" Margin="4,0"
                    Click="Save_Click" IsDefault="True" Background="#E8F5E9" />
            <Button Content="Cancel" Width="70" Height="28" Margin="4,0"
                    Click="Cancel_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
