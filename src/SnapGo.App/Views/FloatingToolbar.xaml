<Window x:Class="SnapGo.App.Views.FloatingToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Topmost="True" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        >
    <Border Background="#F0F0F0" BorderBrush="#C0C0C0" BorderThickness="1"
            CornerRadius="8" Padding="6">
        <Border.Effect>
            <DropShadowEffect Color="#40000000" BlurRadius="12" ShadowDepth="3" Opacity="0.5" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnSave" Content="💾 Save" Width="80" Height="36"
                    Margin="3" Click="BtnSave_Click"
                    Background="#FFFFFF" BorderBrush="#D0D0D0"
                    ToolTip="Save screenshot as PNG" />
            <Button x:Name="BtnOcr" Content="📝 OCR" Width="80" Height="36"
                    Margin="3" Click="BtnOcr_Click"
                    Background="#FFFFFF" BorderBrush="#D0D0D0"
                    ToolTip="Extract text using PaddleOCR-VL" />
            <Button x:Name="BtnAnnotate" Content="✏️ Annotate" Width="90" Height="36"
                    Margin="3" Click="BtnAnnotate_Click"
                    Background="#FFFFFF" BorderBrush="#D0D0D0"
                    ToolTip="Add annotations (rect, arrow, text, pen)" />
            <Button x:Name="BtnCopy" Content="📋 Copy" Width="80" Height="36"
                    Margin="3" Click="BtnCopy_Click"
                    Background="#FFFFFF" BorderBrush="#D0D0D0"
                    ToolTip="Copy image to clipboard" />
        </StackPanel>
    </Border>
</Window>
