<Window x:Class="SnapGo.App.Views.ResultPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR Result" Height="450" Width="650"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        KeyDown="Window_KeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="TxtElapsed" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
            <TextBlock x:Name="TxtModel" FontSize="12" Foreground="Gray" Margin="16,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Loading indicator -->
        <StackPanel x:Name="LoadingPanel" Grid.Row="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock x:Name="TxtLoading" FontSize="14" Foreground="Gray"
                       HorizontalAlignment="Center" />
            <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Error message -->
        <TextBlock x:Name="TxtError" Grid.Row="1"
                   TextWrapping="Wrap" FontSize="14" Foreground="Red"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" />

        <!-- OCR Result text -->
        <TextBox x:Name="ResultTextBox" Grid.Row="1"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 BorderThickness="1" BorderBrush="#D0D0D0"
                 Padding="8" FontSize="14"
                 Visibility="Collapsed" />

        <!-- Action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="📋 Copy Text" Width="100" Height="32" Margin="4,0"
                    Click="CopyText_Click" />
            <Button Content="💾 Save as .txt" Width="110" Height="32" Margin="4,0"
                    Click="SaveText_Click" />
            <Button Content="Close" Width="70" Height="32" Margin="4,0"
                    Click="Close_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
