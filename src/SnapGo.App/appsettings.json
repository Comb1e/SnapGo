{
  "App": {
    "General": {
      "AutoStart": false,
      "StartMinimized": true
    },
    "Hotkey": {
      "Modifiers": "Control+Shift",
      "Key": "S"
    },
    "Docker": {
      "ContainerName": "snapgo-ocr",
      "BaseUrl": "http://localhost:8000",
      "HealthCheckEndpoint": "/health",
      "OcrEndpoint": "/layout-parsing",
      "ModelName": "PaddleOCR-VL-1.5",
      "Mode": "AlwaysOn",
      "IdleTimeoutMinutes": 30,
      "HealthCheckIntervalMs": 500,
      "HealthCheckMaxRetries": 30
    },
    "Ocr": {
      "TimeoutSeconds": 30,
      "MaxRetries": 3,
      "Prompt": "请识别图片中的所有文字，保持原有排版结构，不要添加额外解释。"
    },
    "History": {
      "MaxRecords": 500,
      "MaxDatabaseSizeMb": 200,
      "ThumbnailWidth": 200,
      "ThumbnailHeight": 150
    },
    "Storage": {
      "DefaultSavePath": ".\\save"
    },
    "Logging": {
      "LogLevel": "Information",
      "LogFilePath": "logs/snapgo-.log"
    }
  }
}
